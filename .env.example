# Kamran Cloth House — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env*` is gitignored
# so secrets never reach the repository.

# ── Admin portal (Phase 4.1) ────────────────────────────────────────────────
# Numeric PIN for the /admin login screen. REQUIRED — the login form refuses to
# issue a session while this is unset.
ADMIN_PIN=1990

# Secret used to HMAC-sign the admin session cookie. Use at least 16 random
# characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ── Database (Neon) ─────────────────────────────────────────────────────────
# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it is a full read/write
# credential and must never reach the browser bundle.
#
#   NEON_DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
#
# Then run once:  npm run db:migrate  &&  npm run db:seed
NEON_DATABASE_URL=

# ── Images (Cloudinary) ─────────────────────────────────────────────────────
# Cloud Name and API Key are embedded in client-side upload requests (they are
# public by design). The Secret stays server-side and is only used to sign the
# upload request in /api/upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin used for og:image, sitemap and canonical tags. Set this in
# Vercel once the domain is live, e.g. https://kamrancloth.com.pk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Marketing pixels (PRD §6 — Phase 5) ─────────────────────────────────────
# Also editable at /admin/settings once the backend is wired.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
